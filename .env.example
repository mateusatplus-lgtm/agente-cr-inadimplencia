# ============================================================
# ixc-mcp-server — variáveis de ambiente
# Copie para .env (ou defina no env do mcp_register) e preencha.
# ============================================================

# OBRIGATÓRIA — base do webservice do IXC (sem barra final)
IXC_BASE_URL=https://erp.atplus.cloud

# OBRIGATÓRIA — token de webservice DEDICADO no formato Basic Auth:
# base64 de "usuario:token" (o valor cru do token NÃO funciona —
# o webserver IXC tem Basic Auth na frente da aplicação).
# Como gerar: IXC > Configurações > Usuários > Webservice > Gerar Token
# Como converter (Linux/macOS):  echo -n 'usuario:token' | base64
# Como converter (Windows PowerShell):
#   [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes("usuario:token"))
# NUNCA commitar o valor real — no ATP Work, guardar no cofre ($secret:ixc_token).
IXC_TOKEN=PRENCHA_COM_O_BASE64

# OPCIONAL — default para id_responsavel_tecnico do atendimento.
# Decisão do time: o IXC aceita o campo vazio — deixar VAZIO.
IXC_ID_TECNICO_DEFAULT=

# OPCIONAL — 1/true mocka TODOS os POSTs (su_ticket e cancelamento):
# nada é gravado no IXC; respostas simuladas com payload ecoado.
# Use para demos, treino e validação de fluxo.
IXC_DRY_RUN=

# OPCIONAL — timeout das chamadas HTTP em ms (default 15000)
IXC_TIMEOUT_MS=15000
